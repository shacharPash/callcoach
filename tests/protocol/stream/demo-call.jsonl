{"type": "questions", "t": 1010.0, "items": [{"text": "מה גרם לכם לחפש פתרון עכשיו?", "he": ""}], "lang": "he", "trigger_line_ids": []}
{"type": "status", "t": 1011.0, "state": "active", "elapsed": 1.0, "talk_share": 0.0, "lang_me": "he", "lang_them": "he", "conversation_lang": "he", "agent": "ok", "level": "normal", "visible": true, "hearing": true, "me_voice": true, "paused": false, "transcribing": true, "silent": []}
