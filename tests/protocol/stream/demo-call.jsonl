{"type": "line", "t": 1050.0, "id": 7, "segment_id": 9, "channel": "them", "lang": "en", "text": "Hi everyone, sorry I'm late. Dana told me you're looking at access requests.", "t_start": 1045.1, "speech_end": 1048.9, "line_ready": 1050.0, "conversation_lang": "he"}
{"type": "line", "t": 1056.0, "id": 8, "segment_id": 10, "channel": "them", "lang": "en", "text": "Honestly, we bought Nimbus Labs last year, but nobody uses it. How is yours different?", "t_start": 1051.0, "speech_end": 1054.8, "line_ready": 1056.0, "conversation_lang": "en"}
{"type": "status", "t": 1057.5, "state": "active", "elapsed": 47.5, "talk_share": 0.36, "lang_me": "en", "lang_them": "en", "conversation_lang": "en", "agent": "ok", "level": "normal", "visible": true, "hearing": true, "me_voice": false, "paused": false, "transcribing": true, "silent": []}
{"type": "card", "t": 1057.6, "id": 3, "kind": "question", "text": "What would make you switch?", "lang": "en", "trigger_line_ids": [7, 8], "requested_at": 1056.0, "received_at": 1057.6, "forced": false, "he": "מה יגרום לכם לעבור?"}
